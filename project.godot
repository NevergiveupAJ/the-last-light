; THE LAST LIGHT - Godot 4.3 project settings
config_version=5

[application]

config/name="THE LAST LIGHT"
config/description="Survive. Find. Escape. A mobile 3D survival horror vertical slice."
config/version="0.1.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://scripts/save_system.gd"

[display]

