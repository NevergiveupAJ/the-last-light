{
  // Cloudflare Worker that hosts the playable web build in web/ (made by tools/export_web.sh).
  "name": "the-last-light",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/index.wasm"]
  }
}
